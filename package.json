{
  "name": "noxaplus-subtitle-studio",
  "private": true,
  "version": "1.0.1",
  "description": "A privacy-first, Persian-first subtitle workbench by NoxaPlus that runs entirely in your browser.",
  "author": "NoxaPlus <NoxaPlus2025@gmail.com>",
  "license": "MIT",
  "homepage": "https://www.noxaplus.ir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noxaplus-star/noxaplus-subtitle-studio.git"
  },
  "bugs": {
    "url": "https://github.com/noxaplus-star/noxaplus-subtitle-studio/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/sync-standalone.mjs",
